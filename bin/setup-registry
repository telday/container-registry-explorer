#!/bin/bash

set -e

# Colors for output
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}Setting up Docker Registry with TLS-terminating nginx...${NC}"

# Create network for containers to communicate
echo -e "${GREEN}Creating Docker network...${NC}"
docker network create registry-network 2>/dev/null || echo "Network already exists"

# Create directories for configuration and certificates
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
CERTS_DIR="$PROJECT_DIR/certs"
NGINX_DIR="$PROJECT_DIR/nginx"

mkdir -p "$CERTS_DIR"
mkdir -p "$NGINX_DIR"

# Generate self-signed certificate if it doesn't exist
if [ ! -f "$CERTS_DIR/registry.crt" ]; then
    echo -e "${GREEN}Generating self-signed certificate...${NC}"
    openssl req -newkey rsa:4096 -nodes -sha256 -keyout "$CERTS_DIR/registry.key" \
        -x509 -days 365 -out "$CERTS_DIR/registry.crt" \
        -subj "/C=US/ST=State/L=City/O=Organization/CN=localhost" \
        -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
fi

# Create nginx configuration
echo -e "${GREEN}Creating nginx configuration...${NC}"
cat > "$NGINX_DIR/nginx.conf" << 'EOF'
events {
    worker_connections 1024;
}

http {
    upstream registry {
        server registry:5000;
    }

    server {
        listen 443 ssl;
        server_name localhost;

        ssl_certificate /etc/nginx/certs/registry.crt;
        ssl_certificate_key /etc/nginx/certs/registry.key;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        # Disable buffering for large image uploads
        client_max_body_size 0;
        chunked_transfer_encoding on;

        location / {
            proxy_pass http://registry;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            
            # Required for Docker registry
            proxy_read_timeout 900;
        }
    }

    server {
        listen 80;
        server_name localhost;
        return 301 https://$host$request_uri;
    }
}
EOF

# Stop and remove existing containers if they exist
echo -e "${GREEN}Cleaning up existing containers...${NC}"
docker stop registry-nginx 2>/dev/null || true
docker rm registry-nginx 2>/dev/null || true
docker stop registry 2>/dev/null || true
docker rm registry 2>/dev/null || true

# Start Docker registry container
echo -e "${GREEN}Starting Docker registry container...${NC}"
docker run -d \
    --name registry \
    --network registry-network \
    -v registry-data:/var/lib/registry \
    registry:2

# Start nginx container
echo -e "${GREEN}Starting nginx container with TLS termination...${NC}"
docker run -d \
    --name registry-nginx \
    --network registry-network \
    -p 443:443 \
    -p 80:80 \
    -v "$CERTS_DIR:/etc/nginx/certs:ro" \
    -v "$NGINX_DIR/nginx.conf:/etc/nginx/nginx.conf:ro" \
    nginx:alpine

# Wait for containers to be healthy
echo -e "${GREEN}Waiting for services to start...${NC}"
sleep 3

# Check if containers are running
if docker ps | grep -q registry && docker ps | grep -q registry-nginx; then
    echo -e "${BLUE}✓ Registry setup complete!${NC}"
    echo ""
    echo "Registry is available at: https://localhost"
    echo "You can test it with: curl -k https://localhost/v2/"
    echo ""
    echo "To trust the certificate, add it to your system:"
    echo "  macOS: sudo security add-trusted-cert -d -r trustRoot -k /Library/Keychains/System.keychain $CERTS_DIR/registry.crt"
    echo ""
    echo "To stop the registry:"
    echo "  docker stop registry-nginx registry"
else
    echo -e "${RED}✗ Failed to start containers${NC}"
    exit 1
fi

# Login to the local registry
echo -e "${GREEN}Logging in to registry...${NC}"
docker login localhost

# Pull base alpine image once
echo -e "${GREEN}Pulling base alpine image...${NC}"
docker pull alpine:latest

# Populate registry with test data
echo -e "${GREEN}Populating registry with test images...${NC}"

# Image names for our test data
IMAGE_NAMES=(
    "web-app"
    "api-service"
    "database"
    "cache-server"
    "message-queue"
    "auth-service"
    "frontend"
    "backend"
    "worker"
    "scheduler"
)

# Tags for each image
TAGS=("v1.0.0" "v1.1.0" "v1.2.0" "latest" "stable")

# Create and push all test images
for IMAGE in "${IMAGE_NAMES[@]}"; do
    echo -e "${BLUE}Creating test image: ${IMAGE}${NC}"
    for TAG in "${TAGS[@]}"; do
        docker tag alpine:latest localhost/${IMAGE}:${TAG}
        docker push localhost/${IMAGE}:${TAG} > /dev/null 2>&1
    done
    echo -e "${GREEN}✓ Pushed ${IMAGE} with ${#TAGS[@]} tags${NC}"
done

echo ""
echo -e "${BLUE}✓ Registry populated with ${#IMAGE_NAMES[@]} images, each with ${#TAGS[@]} tags${NC}"
echo ""
echo "You can now explore the registry with:"
echo "  explorer localhost"